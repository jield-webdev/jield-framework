{
  "name": "jield/framework",
  "description": "A modular PHP framework built on top of Laminas, Doctrine, and other powerful libraries, designed to provide a flexible and scalable foundation for web applications.",
  "type": "library",
  "keywords": [
    "bootstrap",
    "module"
  ],
  "license": "MIT",
  "homepage": "https://github.com/jield-webdev/jield-framework",
  "authors": [
    {
      "name": "Johan van der Heide",
      "email": "info@jield.nl",
      "homepage": "https://jield.nl"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "~8.4.0 || ~8.5.0 || ~8.6.0",
    "psr/container": "^2",
    "doctrine/orm": "^3.6",
    "doctrine/dbal": "^4.4",
    "doctrine/common": "^3.5",
    "twig/twig": "^4",
    "gedmo/doctrine-extensions": "~v3.22.0",
    "beberlei/doctrineextensions": "~v1.5.0",
    "laminas/laminas-cache": "^4.3.0",
    "laminas/laminas-cli": "^1.16",
    "laminas/laminas-authentication": "^3",
    "laminas/laminas-cache-storage-adapter-filesystem": "^3.3.0",
    "laminas/laminas-cache-storage-adapter-memory": "^3.3.0",
    "laminas/laminas-cache-storage-adapter-redis": "^3.3.0",
    "laminas/laminas-view": "^3.1.0",
    "laminas/laminas-i18n": "^3.0",
    "laminas/laminas-stdlib": "4.0.x-dev as 3.21.0",
    "laminas/laminas-translator": "^2",
    "laminas/laminas-filter": "^3.4.0",
    "laminas/laminas-config-aggregator": "^1.20",
    "laminas/laminas-inputfilter": "^3",
    "laminas/laminas-validator": "^3.16",
    "laminas/laminas-paginator": "^3.1",
    "laminas/laminas-servicemanager": "^4",
    "laminas/laminas-eventmanager": "^3.15",
    "laminas/laminas-navigation": "^2.4",
    "laminas/laminas-router": "^4",
    "laminas/laminas-hydrator": "^5",
    "laminas/laminas-uri": "^2.15",
    "laminas/laminas-http": "^3.0",
    "laminas/laminas-session": "^3.0",
    "laminas/laminas-serializer": "^4.0",
    "laminas/laminas-permissions-acl": "^3.0",
    "webimpress/safe-writer": "^2.0",
    "solarium/solarium": "^7",
    "bshaffer/oauth2-server-php": "^1.14.1",
    "assetic/framework": "^3.1.3",
    "netglue/laminas-messenger": "^2.5.0",
    "symfony/doctrine-messenger": "^8.0",
    "symfony/mailer": "^8.0",
    "sendgrid/sendgrid": "^8.1.11",
    "mailjet/mailjet-apiv3-php": "^v1.6.6",
    "monolog/monolog": "^3.10",
    "jetbrains/phpstorm-attributes": "^1",
    "zircote/swagger-php": "^7.3",
    "swagger-api/swagger-ui": "^5.20",
    "twbs/bootstrap": "^5.3.8",
    "gsteel/dot": "^1.9.0",
    "symfony/http-client": "^8.1",
    "nyholm/psr7": "^1.8",
    "ext-dom": "*",
    "ext-igbinary": "*",
    "ext-fileinfo": "*",
    "ext-curl": "*",
    "ext-zlib": "*",
    "ext-intl": "*",
    "codename/parquet": "^0.7",
    "jield-webdev/azure-blob-storage": "dev-main",
    "phpoffice/phpspreadsheet": "^5.0",
    "webmozart/assert": "^2.0",
    "psr/link": "^2.0",
    "samsonasik/array-lookup": "^2",
    "seld/jsonlint": "^1.9",
    "laminas/laminas-diactoros": "^3.5",
    "scssphp/scssphp": "^2.0",
    "doctrine/doctrine-laminas-hydrator": "^4",
    "laminas/laminas-permissions-rbac": "^3.7 || ^4.0",
    "tecnickcom/tc-lib-pdf": "^8.83",
    "firebase/php-jwt": "^6.11 || ^7.0",
    "doctrine/migrations": "^3.9"
  },
  "require-dev": {
    "phpstan/phpstan": "2.*",
    "rector/rector": "^2.8.4",
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^13.4",
    "symfony/dom-crawler": "^8.0",
    "symfony/css-selector": "^8.0",
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Jield\\AssetManager\\": "src/asset-manager",
      "Jield\\Authorize\\": "src/authorize",
      "Jield\\ApiTools\\": "src/api-tools",
      "Jield\\Bootstrap5\\": "src/bootstrap5",
      "Jield\\Form\\": "src/form",
      "Jield\\Log\\": "src/log",
      "Jield\\ModuleManager\\": "src/module-manager",
      "Jield\\Mvc\\": "src/mvc",
      "Jield\\Mvc\\Plugin\\FlashMessenger\\": "src/mvc-plugin-flashmessenger",
      "Jield\\Mvc\\Plugin\\Identity\\": "src/mvc-plugin-identity",
      "Jield\\Twig\\": "src/twig",
      "Jield\\Search\\": "src/search",
      "Jield\\Validator\\": "src/validator",
      "DoctrineModule\\": "src/doctrine-module",
      "DoctrineORMModule\\": "src/doctrine-orm-module",
      "Jield\\Export\\": "src/export",
      "Jield\\Recaptcha\\": "src/recaptcha",
      "Jield\\GoogleAnalytics\\": "src/google-analytics",
      "Jield\\ErrorHandler\\": "src/error-handler",
      "Jield\\Cors\\": "src/cors",
      "Jield\\Test\\": "src/test",
      "Jield\\Stdlib\\": "src/stdlib",
      "Jield\\Pdf\\": "src/pdf"
    },
    "files": [
      "src/error-handler/HeroFunction.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "JieldTest\\": "test"
    }
  },
  "config": {
    "vendor-dir": "vendor",
    "optimize-autoloader": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "composer/package-versions-deprecated": true,
      "php-http/discovery": true
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.1.x-dev"
    }
  },
  "scripts": {
    "package:validate": "@composer validate --strict --no-check-all",
    "release:check": "@check",
    "release": "@php bin/release.php",
    "check": [
      "@package:validate",
      "@php-lint",
      "@phpstan",
      "@cs",
      "@cs-test",
      "@mago:check",
      "@test",
      "@security:check"
    ],
    "fix": [
      "@cbf",
      "@cbf-test",
      "@cs-fix"
    ],
    "php-lint": "@php ./vendor/bin/parallel-lint -e php,phtml,dist src test config bin resources .github/scripts autoload.php rector.php",
    "phpstan": "@php ./vendor/bin/phpstan analyse --memory-limit=2G",
    "cs": "./vendor/bin/phpcs -n -p --standard=PSR2 --extensions=php,twig src",
    "cs-test": "./vendor/bin/phpcs -p --standard=PSR12 --extensions=php test",
    "cbf": "./vendor/bin/phpcbf src --standard=PSR2",
    "cbf-test": "./vendor/bin/phpcbf --standard=PSR12 --extensions=php test",
    "cs-fix": "./vendor/bin/php-cs-fixer fix -v src",
    "test": "./vendor/bin/phpunit --no-coverage",
    "mago:check": [
      "@mago:format",
      "@mago:lint",
      "@mago:analyze"
    ],
    "mago:format": "mago format --check",
    "mago:lint": "mago lint",
    "mago:analyze": "mago analyze",
    "security:check": "@composer audit --locked --abandoned=fail --no-interaction",
    "test:consumer": "@php .github/scripts/test-consumer.php",
    "pdf-fonts": "@php bin/build-pdf-fonts.php",
    "post-install-cmd": [
      "@pdf-fonts"
    ],
    "post-update-cmd": [
      "@pdf-fonts"
    ]
  },
  "scripts-descriptions": {
    "package:validate": "Validate publishable Composer metadata (the alpha's exact stdlib alias is intentional).",
    "check": "Run package validation, PHP syntax, static analysis, coding standards, Mago, tests, and the dependency audit.",
    "release:check": "Run the complete local quality gate before tagging a release (requires Mago 1.59.0).",
    "mago:check": "Check formatting, lint rules, and static analysis with Mago 1.59.0.",
    "security:check": "Audit locked dependencies for security advisories and abandoned packages.",
    "release": "Check and tag a release on main: composer release -- 0.1.0-alpha.1 [--dry-run].",
    "test:consumer": "Install the committed distribution archive in a separate Composer application."
  }
}
